# Copy this file to .env and fill in the values
# The .env file is gitignored and should never be committed

# Sentry DSN for error tracking (https://docs.sentry.io/product/sentry-basics/dsn-explainer/)
EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# YouTube BotGuard request key used for PoToken generation
YOUTUBE_REQUEST_KEY=<your_request_key>
