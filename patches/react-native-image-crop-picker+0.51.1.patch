+- (void)safeResolve:(id)result {
+    if (self.hasFinished || self.resolve == nil) {
+        return;
+    }
+
+    self.hasFinished = YES;
+    RCTPromiseResolveBlock resolve = self.resolve;
+    self.resolve = nil;
+    self.reject = nil;
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        resolve(result);
+    });
+}
+
+- (void)safeReject:(NSString *)code message:(NSString *)message error:(NSError *)error {
+    if (self.hasFinished || self.reject == nil) {
+        return;
+    }
+
+    self.hasFinished = YES;
+    RCTPromiseRejectBlock reject = self.reject;
+    self.resolve = nil;
+    self.reject = nil;
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        reject(code, message, error);
+    });
+}
