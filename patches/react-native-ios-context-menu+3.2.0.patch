+/** wrapper for timeout that returns a promise */
+export function timeout(ms) {
+  return new Promise(resolve => {
+    const timeoutID = setTimeout(() => {
+      clearTimeout(timeoutID);
+      resolve();
+    }, ms);
+  });
+}
+;
