+    // MARK: - espeak-ng-data
+
+    /// Downloaded Piper/Kokoro models need espeak-ng-data alongside them for
+    /// English phonemization — without it, SherpaOnnxCreateOfflineTts silently
+    /// returns a null handle (see the nil-guards in Piper/KokoroEngine.load()).
+    /// Rather than re-download ~18MB per model, reuse the copy already bundled
+    /// into the app via the SherpaOnnx pod's PiperModels resource bundle.
+    private static func ensureEspeakNgData(in destDir: URL) {
+        let dest = destDir.appendingPathComponent("espeak-ng-data")
+        if FileManager.default.fileExists(atPath: dest.path) { return }
+        guard let source = bundledEspeakNgDataDir() else { return }
+        try? FileManager.default.copyItem(atPath: source, toPath: dest.path)
+    }
+
+    private static func bundledEspeakNgDataDir() -> String? {
+        var bundles: [Bundle] = [Bundle.main]
+        if let url = Bundle.main.url(forResource: "PiperModels", withExtension: "bundle"),
+           let b = Bundle(url: url) {
+            bundles.insert(b, at: 0)
+        }
+        for bundle in bundles {
+            guard let root = bundle.resourceURL else { continue }
+            let candidate = root.appendingPathComponent("espeak-ng-data")
+            var isDir: ObjCBool = false
+            if FileManager.default.fileExists(atPath: candidate.path, isDirectory: &isDir), isDir.boolValue {
+                return candidate.path
+            }
+            guard let walker = FileManager.default.enumerator(at: root, includingPropertiesForKeys: nil) else { continue }
+            for case let url as URL in walker where url.lastPathComponent == "espeak-ng-data" {
+                return url.path
+            }
+        }
+        return nil
+    }
+
