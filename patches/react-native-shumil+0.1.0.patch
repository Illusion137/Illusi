diff --git a/node_modules/react-native-shumil/ios/SherpaTuning.swift b/node_modules/react-native-shumil/ios/SherpaTuning.swift
new file mode 100644
index 0000000..4c9be7a
--- /dev/null
+++ b/node_modules/react-native-shumil/ios/SherpaTuning.swift
@@ -0,0 +1,34 @@
+import Foundation
+
+// Threading plans for the sherpa-onnx engines (Piper, Kokoro).
+//
+// A batch of paragraphs is CPU-bound ONNX inference. Two knobs compete for the
+// same cores:
+//   - intra-op threads per generate() call (onnxruntime numThreads)
+//   - parallel generate() calls (exportBatch concurrency)
+//
+// Independent paragraphs scale near-linearly while intra-op scaling is
+// sublinear, so the plans lean on streams — but the optimum differs by model
+// size (measured on an M3 with real book paragraphs, sherpa-onnx 1.13.x):
+//
+//   Piper (VITS ~20M params): matmuls are too small to split — intra-op
+//   threading is pure overhead. 1 thread x cores-many streams won at 56.8x
+//   realtime vs 49.4x for 2 threads x 4 streams and 36.4x for 4x2.
+//
+//   Kokoro (~82M params): big enough that 2 intra-op threads still pay for
+//   themselves, and it saturates memory bandwidth before core count — extra
+//   streams past cores/2 made it WORSE (2x4 = 3.6x realtime vs 1x8 = 3.3x).
+enum SherpaTuning {
+    // Piper: single-threaded inference, one stream per core.
+    static let piperThreadsPerGenerate = 1
+    static var piperBatchConcurrency: Int {
+        max(1, ProcessInfo.processInfo.processorCount)
+    }
+
+    // Kokoro: 2 intra-op threads, cores/2 streams — measured optimum; raising
+    // streams past this oversubscribes memory bandwidth and regresses.
+    static let kokoroThreadsPerGenerate = 2
+    static var kokoroBatchConcurrency: Int {
+        max(1, ProcessInfo.processInfo.processorCount / kokoroThreadsPerGenerate)
+    }
+}
