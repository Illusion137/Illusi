	"main": "index",
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"exclude": [
					"react-native-track-player",
					"@simform_solutions/react-native-audio-waveform",
					"react-native-siri-shortcut",
					"react-native-ota-hot-update",
					"react-native-fs"
				],
				"listUnknownPackages": false
			}
		},
		"autolinking": {
			"android": {
				"exclude": [
					"react-native-carplay",
					"nodejs-mobile-react-native"
				]
			},
			"ios": {
				"exclude": []
			}
		}
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"start": "expo start --dev-client",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"ts:check": "tsc -p tsconfig.json",
		"run:dev": "sh scripts/run_dev.sh",
		"run:sim": "sh scripts/run_sim.sh",
		"build:dev": "sh scripts/build_dev.sh",
		"build:sim": "sh scripts/build_sim.sh",
		"build:prod": "sh scripts/build_prod.sh",
		"publish": "eas submit -p ios",
		"postinstall": "patch-package",
		"lint": "expo lint",
		"ota:release": "sh scripts/ota_release.sh",
		"bump": "node scripts/bump_version.js",
		"bump:minor": "node scripts/bump_version.js minor",
		"bump:major": "node scripts/bump_version.js major",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{js,mjs,json,yaml,yml,md}": [
			"prettier --write"
		]
	},
